# Pi Long Run worker (Node 22)
FROM node:22-bookworm-slim AS builder

WORKDIR /app
COPY services/pi-long-run/package.json ./
RUN npm install

COPY services/pi-long-run/tsconfig.json ./
COPY services/pi-long-run/src ./src
COPY services/pi-long-run/extensions ./extensions
RUN npm run build

FROM node:22-bookworm-slim

WORKDIR /app
ENV NODE_ENV=production
ENV AION_PI_WORKER_PORT=8791
ENV AION_PI_WORKER_HOST=0.0.0.0

COPY --from=builder /app/package.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/extensions ./extensions

EXPOSE 8791
CMD ["node", "dist/src/server.js"]
